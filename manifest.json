{
  "manifest_version": 3,
  "name": "Tabsaic",
  "version": "3.2",
  "description": "A new tab page of big link tiles, grouped by topic.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "bookmarks"
  ]
}
